{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean:test": "node -e \"require('fs').rmSync('.test-dist',{recursive:true,force:true})\"",
    "test:compile": "npm run clean:test && tsc -p tsconfig.test.json",
    "test": "npm run test:compile && node --test .test-dist/lib/__tests__/url-validation.test.js",
    "test:watch": "npm run test:compile && node --test --watch .test-dist/lib/__tests__/url-validation.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.112.0",
    "@types/node": "20.6.2",
    "@types/react": "18.2.22",
    "@types/react-dom": "18.2.7",
    "autoprefixer": "10.4.15",
    "eslint": "8.49.0",
    "eslint-config-next": "13.5.1",
    "lucide-react": "^1.28.0",
    "next": "13.5.1",
    "postcss": "8.4.30",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.3.3",
    "typescript": "5.2.2"
  }
}
